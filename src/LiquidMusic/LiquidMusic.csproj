<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>..\..\ui\assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="Vosk" Version="0.3.38" />
  </ItemGroup>

  <Target Name="RemoveUnusedWebViewWpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="$([System.String]::Copy('%(Reference.Identity)').EndsWith('Microsoft.Web.WebView2.Wpf.dll'))" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\ui\**\*" CopyToOutputDirectory="PreserveNewest" Link="ui\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\..\ui\assets\liquid-mood\**\*" CopyToOutputDirectory="PreserveNewest" Link="assets\liquid-mood\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="assets\liquid-mood\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\models\vosk-model-small-ru-0.22\**\*" Link="models\vosk-model-small-ru-0.22\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="models\vosk-model-small-ru-0.22\**\*" Condition="!Exists('..\..\models\vosk-model-small-ru-0.22')" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="BrowserScripts.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
